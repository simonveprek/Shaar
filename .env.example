# Copy to .env.local for local dev. On Netlify set these in Site configuration > Environment variables.

# Supabase (Project Settings > API). The secret key (or legacy service_role key) stays server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Optional. Signs the visitor cookie; derived from the secret key when empty.
VISITOR_SECRET=

# Apify (Console > Settings > API & Integrations)
APIFY_TOKEN=
# Any random string of 16+ chars, e.g. `openssl rand -hex 24`. Guards /api/webhooks/apify.
APIFY_WEBHOOK_SECRET=
# Max USD a single actor run may spend.
APIFY_MAX_CHARGE_USD_PER_RUN=1

# OpenAI
OPENAI_API_KEY=
# Persona builder (quality matters) and chat (speed matters).
OPENAI_PERSONA_MODEL=gpt-6.1-sol
OPENAI_CHAT_MODEL=gpt-6-luna
# Candidate feedback after a practice interview (optional, defaults to OPENAI_PERSONA_MODEL).
OPENAI_FEEDBACK_MODEL=

# ElevenLabs
ELEVENLABS_API_KEY=
# Voice used for personas unless the frontend picks one (Voice Library > voice > ID).
ELEVENLABS_DEFAULT_VOICE_ID=
# LLM the voice agent runs on while playing the persona, and its TTS model.
ELEVENLABS_AGENT_LLM=gpt-6-luna
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# From the post-call webhook you create in ElevenLabs (Agents > Settings > Webhooks).
ELEVENLABS_WEBHOOK_SECRET=

# Public URL of this backend, e.g. https://projstalker-api.netlify.app. Enables Apify webhooks.
# Leave empty locally: job progress is then pulled when the frontend polls GET /api/research/:id.
PUBLIC_API_URL=

# Frontend origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3000
